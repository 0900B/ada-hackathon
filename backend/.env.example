# Optional settings. Set them under Railway -> Variables (or export them locally).
# All have sensible defaults, so the app runs without any of them.
SIM_TICK_S=2          # real seconds between simulation ticks
SIM_SPEEDUP=5         # simulated seconds per real second (5 = a 20-min trip takes 4 real minutes)
WEATHER_INTERVAL_S=600
TRAFFIC_INTERVAL_S=30
RANDOM_SEED=42
# ANTHROPIC_API_KEY=  # Claude agent; without it the engine's own plan is shown
# TOMTOM_API_KEY=     # live traffic flow + incidents; without it a time-of-day profile is used
# TOMTOM_INTERVAL_S=300
# NAP_USERNAME=       # promet.si/DARS events via the National Access Point (www.nap.si): your NAP login email
# NAP_PASSWORD=       # ...and password; dataset permissions must be approved by NAP first
# NAP_DATASETS=b2b.events   # comma-separated, e.g. b2b.events,b2b.roadworks
# NAP_INTERVAL_S=120
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_EFFORT=medium
# AGENT_AUTO=1
