# Settings of the backend, read from environment variables (Railway -> Variables, or export them locally).
# Nothing loads this file: it only documents the names. Every variable has a default, so the app runs
# with none of them (no Claude, no TomTom: the engine's own plan and a time-of-day traffic profile).
# Every line is commented out and each comment sits above its variable, so pasting the whole file into
# Railway's raw editor sets nothing by accident. Never put real keys in this file or in the repository.

# --- Secrets (set them in the Railway dashboard only) ---------------------------------------------------

# Claude (triage of 112 calls, crew messages, the AI dispatcher). Without it: keyword rules, the engine's own plan.
# ANTHROPIC_API_KEY=

# TomTom (traffic flow, incidents, backup routing, detours around closures, traffic map tiles). Without it: time-of-day profile, no detours.
# TOMTOM_API_KEY=

# promet.si / DARS events through the National Access Point (www.nap.si): your NAP login email and password.
# Dataset permissions must be approved by NAP first; without both, the promet.si feed is simply not started.
# NAP_USERNAME=
# NAP_PASSWORD=

# Demo lock for the live pitch: when set, every POST/PUT/PATCH/DELETE needs the header "X-Plan-B-Key: <this value>".
# Reading stays open. Open each of our devices once with ?key=<value>. Use a long random string. Empty or unset = no lock
# (local dev, tests, CI); /health then says admin_lock: false and the dashboard header says "No lock set".
# ADMIN_KEY=

# PostgreSQL for the audit log. On Railway this is a REFERENCE variable that points at the Postgres service's DATABASE_URL
# (add it with "Add Reference"), not a pasted copy. Without it the audit log lives in memory only (last 2,000 entries,
# lost on a restart); /health shows audit.status "memory only (no DATABASE_URL)".
# DATABASE_URL=

# --- Claude agent ---------------------------------------------------------------------------------------

# Model for every Claude call.
# AGENT_MODEL=claude-sonnet-5-5
# Reasoning effort of the AI dispatcher's analyses: low | medium | high | xhigh | max (triage and message parsing always use low).
# AGENT_EFFORT=medium
# 1 = each world's auto-analyse switch starts on (default 0: saves tokens; the dispatcher presses A, or switches it on).
# AGENT_AUTO=0
# Most tool turns (API requests) of one analysis.
# AGENT_MAX_TURNS=10
# Deadline in seconds for a whole analysis (all turns and retries); after it the engine's own plan is shown.
# AGENT_TIMEOUT_S=60

# --- Claude usage guard (analyses, reviews, crew messages, 112 triage; both worlds share it) -----------------

# Allowed Claude calls per rolling window.
# CLAUDE_MAX_PER_5MIN=12
# Length of that window in seconds.
# CLAUDE_WINDOW_S=300
# Allowed Claude calls per UTC day. Over a limit: engine plan, automatic analyses skipped, crew messages get HTTP 429.
# CLAUDE_MAX_PER_DAY=300

# --- Simulation and live calls --------------------------------------------------------------------------

# Real seconds between simulation ticks.
# SIM_TICK_S=2
# Simulation world: simulated seconds per real second (5 = a 20-minute trip takes 4 real minutes).
# SIM_SPEEDUP=5
# Live world: simulated seconds per real second (1 = the real clock).
# LIVE_SPEEDUP=1
# Seed of the synthetic fleet, crews and call stream.
# RANDOM_SEED=42
# 0 = live calls (default); 1 = the vans start with a pre-planned scheduled day (the brief's initial plan).
# SCHEDULED_DAY=0
# 1 = the synthetic call generator starts on in both worlds (switch it per world later: Scenarios tab in the Simulation, POST /{world}/admin/calls).
# CALLS_ENABLED=1
# Synthetic calls per WORLD hour (the Simulation world runs 5x faster, so 5 per world hour is about one per 2.4 real minutes there).
# CALLS_PER_HOUR=5

# --- Data feeds and routing -----------------------------------------------------------------------------

# Seconds between weather fetches (Open-Meteo, backup MET Norway).
# WEATHER_INTERVAL_S=600
# Seconds between updates of the time-of-day traffic profile (used when there is no TomTom key).
# TRAFFIC_INTERVAL_S=30
# TomTom traffic flow every N seconds (free plan: 20,000 flow + 2,500 incident requests per month).
# TOMTOM_INTERVAL_S=300
# TomTom incidents every N seconds.
# TOMTOM_INCIDENTS_INTERVAL_S=600
# Daily caps per TomTom API; at the cap the backup takes over and the status bar says so.
# TOMTOM_DAILY_FLOW_CAP=2000
# TOMTOM_DAILY_INCIDENT_CAP=150
# TOMTOM_DAILY_ROUTING_CAP=500
# Traffic map tiles per day (free plan: 200,000 tile requests per month).
# TOMTOM_DAILY_TILE_CAP=25000
# Comma-separated NAP datasets to read, e.g. b2b.events,b2b.roadworks.
# NAP_DATASETS=b2b.events
# Seconds between promet.si fetches (NAP updates about every minute).
# NAP_INTERVAL_S=120
# 0 turns road routing off (straight-line distance x 1.35, as in the tests and the benchmark).
# ROAD_ROUTING=1
# Your own OSRM server instead of the public demo server (which allows about one request per second).
# OSRM_URL=https://router.project-osrm.org
# User-Agent of the backend's outgoing HTTP requests; MET Norway asks clients to identify themselves (add a contact address if you like).
# HTTP_USER_AGENT=adahack-transport-backend/0.1

# --- Misc -----------------------------------------------------------------------------------------------

# Name of the audit table in PostgreSQL.
# AUDIT_TABLE=audit_log
# Port of the web server (Railway sets it by itself; locally 8000).
# PORT=8000
