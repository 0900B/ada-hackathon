# Optional settings. Set them under Railway -> Variables (or export them locally).
# All have sensible defaults, so the app runs without any of them.
SIM_TICK_S=2          # real seconds between simulation ticks
SIM_SPEEDUP=5         # simulated seconds per real second (5 = a 20-min trip takes 4 real minutes)
WEATHER_INTERVAL_S=600
TRAFFIC_INTERVAL_S=30
RANDOM_SEED=42
# SCHEDULED_DAY=0     # 0 = live calls (default), 1 = the vans start with a pre-planned scheduled day
# CALLS_ENABLED=1     # live-calls generator on/off
# CALLS_PER_HOUR=8    # calls per world hour (live-calls mode)
# ANTHROPIC_API_KEY=  # Claude agent; without it the engine's own plan is shown
# TOMTOM_API_KEY=     # live traffic flow + incidents; without it a time-of-day profile is used
# TOMTOM_INTERVAL_S=300            # flow; free plan: 20,000 flow + 2,500 incident requests per month
# TOMTOM_INCIDENTS_INTERVAL_S=600
# TOMTOM_DAILY_FLOW_CAP=2000
# TOMTOM_DAILY_INCIDENT_CAP=150
# TOMTOM_DAILY_TILE_CAP=25000     # traffic map tiles; free plan: 200,000 tile requests per month
# NAP_USERNAME=       # promet.si/DARS events via the National Access Point (www.nap.si): your NAP login email
# NAP_PASSWORD=       # ...and password; dataset permissions must be approved by NAP first
# NAP_DATASETS=b2b.events   # comma-separated, e.g. b2b.events,b2b.roadworks
# NAP_INTERVAL_S=120
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_EFFORT=medium
# AGENT_AUTO=1
# AGENT_TIMEOUT_S=60       # deadline for a whole AI analysis; after it the engine's plan is shown
# CLAUDE_MAX_PER_5MIN=12   # Claude usage guard (analyses + field messages, both worlds): per rolling window
# CLAUDE_WINDOW_S=300
# CLAUDE_MAX_PER_DAY=300   # ... and per UTC day; over it: engine plan, automatic analyses skipped, messages 429
